---
import DefaultFooter from '@astrojs/starlight/components/Footer.astro';
const { entry } = Astro.locals.starlightRoute;
---

{entry.data.template === 'splash' ? (
  <footer class="vt-footer">
    <span>VeriTile <span class="vt-footer__separator" aria-hidden="true">/</span> Source code and documentation</span>
    <a href="https://github.com/Lizn-zn/VeriTile/blob/main/LICENSE">MIT License ↗</a>
  </footer>
) : <DefaultFooter />}

<style>
  .vt-footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; max-width: 55rem; margin: 0 auto; padding: 1.5rem 0; border-top: 1px solid var(--vt-rule); color: var(--vt-ink-2); font: 400 .67rem/1.6 'IBM Plex Mono', monospace; }
  .vt-footer__separator { margin: 0 .7rem; color: var(--vt-seal); }
  a { color: var(--vt-seal-ink); text-decoration: none; }
  a:hover { text-decoration: underline; text-underline-offset: .2em; }
  a:focus-visible { outline: 2px solid var(--vt-seal); outline-offset: 4px; }
</style>
