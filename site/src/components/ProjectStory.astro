---
import { Code } from 'astro:components';
import KernelDemo from './KernelDemo.astro';
import FlashAttentionExample from './FlashAttentionExample.astro';
import { homeStory } from '../lib/home-story';
import { corpus, proofInventory, vectorAddBodies } from '../lib/project-data';
const { docsBase, github } = Astro.props;
const copy = homeStory;
const themes = { light: 'github-light', dark: 'github-dark-dimmed' } as const;
const source = (path: string) => `${github}/blob/main/${path}`;
---

<div class="vt-story">
  <section class="story-section language-section" id="language" aria-labelledby="language-title">
    <header><h2 id="language-title">{copy.languageTitle}</h2><p>{copy.languageLead} <span class="language-emphasis">{copy.languageEmphasis}</span>. {copy.languageText}</p></header>
    <div class="language-pair">
      <div>
        <div class="language-code-heading"><h3>{copy.pythonLabel}</h3><p>{copy.pythonRole}</p></div>
        <Code code={vectorAddBodies.python} lang="python" themes={themes} wrap={true} tabindex="0" aria-label={copy.pythonLabel} />
      </div>
      <div>
        <div class="language-code-heading"><h3>{copy.leanLabel}</h3><p>{copy.leanRole}</p></div>
        <Code code={vectorAddBodies.lean} lang="lean" themes={themes} wrap={true} tabindex="0" aria-label={copy.leanLabel} />
      </div>
    </div>
    <div class="source-caption">
      <p>{copy.languageNote}</p>
      <div class="source-links"><a href={source('bench/examples/VectorAdd.lean')}>Example source ↗</a><a href={`${docsBase}/cookbook/vector-add-walkthrough/`}>Complete VectorAdd tutorial →</a><a href={`${docsBase}/architecture/triton-subset/`}>{copy.languageLink} →</a></div>
    </div>
  </section>

  <section class="story-section" id="proofs" aria-labelledby="proofs-title">
    <header><h2 id="proofs-title">{copy.proofTitle}</h2><p>{copy.proofText}</p></header>
    <div class="proof-pair">
      {copy.proofCards.map((card) => (
        <article class="proof-card" aria-labelledby={`${card.id}-title`}>
          <div class="proof-card-heading">
            <p class="kicker">{card.label}</p><h3 id={`${card.id}-title`}>{card.title}</h3>
            <p class="proof-description">{card.description}</p>
          </div>
          <div class="proof-relation" aria-describedby="proof-relation-note">
            <code><span>{card.relationLeft}</span> <span class="relation-operator">{card.relationOperator}</span> <span>{card.relationRight}</span></code>
          </div>
          <dl class="proof-criteria">
            <div><dt>{copy.computationLabel}</dt><dd>{card.computation}</dd></div>
            <div><dt>{copy.memoryLabel}</dt><dd>{card.memory}</dd></div>
          </dl>
          <div class="proof-example">
            <h4><span>{copy.proofExampleLabel} · </span>{card.example}</h4><p>{card.exampleText}</p>
          </div>
          <details class="proof-details">
            <summary>{copy.proofDetailsLabel}<span class="sr-only">: {card.example}</span></summary>
            <div class="proof-visual">
              <p class="formula" aria-label={card.formulaLabel}><span>{card.formulaLeft}</span><span>= {card.formulaRight}</span></p>
            </div>
            <p class="scope-note">{card.exampleCaption}</p><p>{card.scope}</p>
          </details>
          <a class="proof-source" href={source(card.source)}>{copy.proofLink}<span class="sr-only">: {card.example}</span> ↗</a>
        </article>
      ))}
    </div>
    <p class="scope-note" id="proof-relation-note">{copy.proofRelationNote}</p>
    <details class="try-example" id="try-example">
      <summary><span>{copy.tryLabel}</span><span>{copy.tryText}</span></summary>
      <div><KernelDemo {docsBase} {github} /></div>
    </details>
  </section>

  <section class="story-section" id="agents" aria-labelledby="agents-title">
    <header><h2 id="agents-title">{copy.agentTitle}</h2><p>{copy.agentText}</p></header>
    <div class="agent-pair">
      <article class="agent-panel" aria-labelledby="lemmas-title">
        <h3 id="lemmas-title">{copy.lemmaTitle}</h3>
        <p class="agent-description">{copy.lemmaText}</p>
        <ul class="lemma-groups">
          {copy.lemmaGroups.map((group) => (
            <li><h4><a href={source(`VeriTile/Triton/KernelLemmas/${group.source}.lean`)}>{group.title}<span aria-hidden="true"> ↗</span></a></h4><p>{group.text}</p></li>
          ))}
        </ul>
      </article>
      <article class="agent-panel" aria-labelledby="generation-title">
        <h3 id="generation-title">{copy.generationTitle}</h3>
        <p class="agent-description">{copy.generationText}</p>
        <div class="proof-process">
          <p class="process-input">{copy.generationInput}</p>
          <span class="process-arrow" aria-hidden="true">↓</span>
          <ol class="agent-cycle">
            {copy.agentSteps.map((step) => <li><h4>{step.title}</h4><p>{step.text}</p></li>)}
          </ol>
          <p class="process-feedback"><span aria-hidden="true">↶</span>{copy.feedback}</p>
          <div class="process-output"><span>{copy.generationSuccess}</span><p><span aria-hidden="true">✓</span>{copy.generationOutput}</p></div>
        </div>
      </article>
    </div>
    <div class="inline-links"><a href={source('scripts/README.md')}>{copy.harnessLink} ↗</a><a href={`${docsBase}/proofs/trust-audit/`}>{copy.trustLink} →</a></div>
  </section>

  <section class="story-section" id="examples" aria-labelledby="results-title">
    <header><h2 id="results-title">{copy.resultsTitle}</h2><p>{copy.resultsText}</p></header>
    <div class="results-pair">
      <article class="attention">
        <p class="kicker">{copy.attentionLabel}</p><h3>{copy.attentionTitle}</h3>
        <p class="attention-formula">softmax(QKᵀ · scale) V</p>
        <ul class="attention-parts">{copy.attentionParts.map((part) => <li><span aria-hidden="true">✓</span>{part}</li>)}</ul>
        <p>{copy.attentionText}</p>
        <a href="#flash-attention-example" class="attention-example-link">View example <span aria-hidden="true">↓</span></a>
      </article>
      <aside class="corpus" id="benchmark" aria-labelledby="corpus-title">
        <h3 id="corpus-title">{copy.corpusTitle}</h3>
        <p class="corpus-count"><strong>{corpus.pairedPorts}</strong><span>/ {corpus.totalDirectories}</span></p><p class="count-label">{copy.ports}</p>
        <div class="corpus-grid" aria-hidden="true">{Array.from({ length: corpus.totalDirectories }, (_, i) => <span class:list={{ paired: i < corpus.pairedPorts }}></span>)}</div>
        <p class="statement-count"><strong>{proofInventory.statements}</strong> {copy.statements}</p>
        <p>{copy.corpusText}</p>
        <a href={source('bench/tritonbench_g/completion_audit.md')}>{copy.auditLink} ↗</a>
        <a href={`${docsBase}/proofs/coverage/`}>Browse theorem coverage →</a>
        <a href={`${docsBase}/status/`}>{copy.coverageLink} →</a>
        <p class="scope-note">{copy.corpusNote}</p>
      </aside>
    </div>
    <FlashAttentionExample {github} />
    <a class="all-examples" href={`${github}/tree/main/bench/examples`}>{copy.allExamples} ↗</a>
  </section>

</div>

<script>
  const openLinkedExample = () => {
    const id = window.location.hash === '#example' ? 'try-example' : window.location.hash.slice(1);
    if (!['try-example', 'flash-attention-example'].includes(id)) return;
    const example = document.getElementById(id) as HTMLDetailsElement | null;
    if (!example) return;
    example.open = true;
    requestAnimationFrame(() => example.scrollIntoView({ block: 'start' }));
  };
  openLinkedExample();
  window.addEventListener('hashchange', openLinkedExample);
  document.querySelector<HTMLAnchorElement>('.attention-example-link')?.addEventListener('click', () => {
    // A second click must reopen the reader even if the URL hash is unchanged.
    const example = document.querySelector<HTMLDetailsElement>('#flash-attention-example');
    if (example) example.open = true;
  });
</script>

<style>
  .vt-story { font-size: var(--vt-text-body); line-height: 1.8; }
  .vt-story * { box-sizing: border-box; }
  .vt-story a { color: var(--vt-seal-ink); text-decoration: none; font-size: var(--vt-text-small); }
  .vt-story a:hover { text-decoration: underline; text-underline-offset: .2em; }
  .vt-story :is(a, summary):focus-visible, .vt-story :global(pre:focus-visible) { outline: 2px solid var(--vt-seal); outline-offset: 3px; }
  .story-section { padding: 2.6rem 0; border-top: 1px solid var(--vt-rule); scroll-margin-top: 5rem; }
  .language-section { border-top: 0; padding-top: .6rem; }
  header { margin-bottom: 1.4rem; }
  h2 { margin: 0; font: 500 clamp(1.15rem, 2.5vw, 1.4rem)/1.5 'IBM Plex Mono', monospace; letter-spacing: -.035em; }
  h3 { margin: 0; font: 500 1rem/1.6 'IBM Plex Mono', monospace; letter-spacing: -.025em; }
  p { margin: .6rem 0; color: var(--vt-ink-2); }
  header p { max-width: 49rem; margin-bottom: 0; }
  .language-emphasis { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .2em; }
  .vt-story :global(pre) { background: transparent !important; margin: 0; font: var(--vt-text-code)/1.7 'IBM Plex Mono', monospace; }
  .vt-story :global(code) { font: inherit; }
  :global(html[data-theme='dark']) .vt-story :global(.astro-code),
  :global(html[data-theme='dark']) .vt-story :global(.astro-code span) { color: var(--shiki-dark) !important; }
  .language-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  .language-pair > div { min-width: 0; border: 1px solid var(--vt-rule-2); border-radius: 3px; overflow: hidden; }
  .language-code-heading { padding: .65rem 1rem; background: var(--vt-paper-2); border-bottom: 1px solid var(--vt-rule); }
  .language-code-heading h3 { margin: 0; font-size: var(--vt-text-small); color: var(--vt-ink); letter-spacing: .045em; }
  .language-code-heading p { margin: .2rem 0 0; font-size: var(--vt-text-small); color: var(--vt-ink-3); }
  .language-pair :global(pre) { padding: 1rem; }
  .source-caption { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: .2rem 1.2rem; margin-top: .6rem; }
  .source-caption p { font-size: var(--vt-text-small); color: var(--vt-ink-3); }
  .source-caption a { white-space: nowrap; font-size: var(--vt-text-small); }
  .source-links { display: flex; flex-wrap: wrap; gap: .5rem 1.2rem; }
  .scope-note { color: var(--vt-ink-3); font-size: var(--vt-text-small); }
  .inline-links { display: flex; flex-wrap: wrap; gap: .6rem 1.6rem; margin-top: .7rem; }
  .proof-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1.25rem; }
  .proof-card { display: grid; grid-template-rows: subgrid; grid-row: span 7; row-gap: 0; min-width: 0; padding: 1.2rem; border: 1px solid var(--vt-rule-2); border-radius: 3px; }
  .proof-description { margin: .6rem 0 1.2rem; font-size: var(--vt-text-body); }
  .proof-relation { display: flex; align-items: center; margin-bottom: 1.2rem; padding: 1rem; background: var(--vt-paper-2); border-radius: 3px; color: var(--vt-ink); font-size: .9rem; line-height: 1.8; }
  .proof-relation code > span { white-space: nowrap; }
  .relation-operator { color: var(--vt-seal-ink); }
  .proof-criteria { display: grid; grid-template-rows: subgrid; grid-row: span 2; row-gap: 0; margin: 0; }
  .proof-criteria > div { padding-bottom: 1rem; }
  .proof-criteria dt { color: var(--vt-ink); font-size: var(--vt-text-small); font-weight: 500; }
  .proof-criteria dd { margin: .3rem 0 0; color: var(--vt-ink-2); font-size: var(--vt-text-body); }
  .proof-example { border-top: 1px solid var(--vt-rule); padding-top: 1rem; }
  .proof-example h4 { margin: 0; font-size: var(--vt-text-small); font-weight: 500; color: var(--vt-ink); }
  .proof-example h4 span { color: var(--vt-ink-3); font-weight: 400; }
  .proof-example > p { margin: .4rem 0 0; font-size: var(--vt-text-body); }
  .proof-visual { display: flex; align-items: center; min-height: 5.75rem; padding: 1rem; background: var(--vt-paper-2); border-radius: 3px; }
  .proof-details { --vt-text-body: var(--vt-text-small); margin: .9rem 0; font-size: var(--vt-text-small); }
  .proof-details summary { cursor: pointer; color: var(--vt-ink-2); }
  .proof-details .proof-visual { margin-top: .8rem; }
  .proof-details p { margin: .6rem 0; font-size: var(--vt-text-body); }
  .kicker { margin: 0 0 .4rem; font-size: var(--vt-text-small); letter-spacing: .025em; color: var(--vt-seal-ink); }
  .proof-source { align-self: end; padding-top: .2rem; font-size: var(--vt-text-small); }
  #proof-relation-note { margin: .8rem 0 0; }
  .formula { display: flex; flex-direction: column; margin: 0; color: var(--vt-ink); font-size: 1.1rem; letter-spacing: -.04em; }
  .try-example { margin-top: 1.8rem; border-block: 1px solid var(--vt-rule); }
  .try-example > summary { cursor: pointer; padding: .95rem 0; }
  .try-example > summary > span:first-child { font-weight: 500; color: var(--vt-ink); font-size: var(--vt-text-small); }
  .try-example > summary > span:last-child { display: inline; margin-left: 1rem; font-size: var(--vt-text-small); color: var(--vt-ink-3); }
  .try-example > div { padding-top: 1rem; }
  .try-example :global(.vt-demo) { margin-bottom: 1.5rem; }
  .agent-pair { display: grid; grid-template-columns: 1fr 1fr; gap: 0 1.25rem; }
  .agent-panel { display: grid; grid-template-rows: subgrid; grid-row: span 3; row-gap: 0; min-width: 0; padding: 1.2rem; border: 1px solid var(--vt-rule-2); border-radius: 3px; }
  .agent-description { margin: .6rem 0 1.2rem; font-size: var(--vt-text-body); }
  .lemma-groups { list-style: none; margin: 0; padding: 0; }
  .lemma-groups li { padding: .9rem 0; border-top: 1px solid var(--vt-rule); }
  .lemma-groups li:first-child { padding-top: 0; border-top: 0; }
  .lemma-groups li:last-child { padding-bottom: 0; }
  .agent-panel h4 { margin: 0; font-size: var(--vt-text-small); font-weight: 500; color: var(--vt-ink); }
  .lemma-groups a { color: var(--vt-ink); }
  .lemma-groups a > span { color: var(--vt-seal-ink); }
  .lemma-groups p { margin: .3rem 0 0; font-size: var(--vt-text-body); }
  .proof-process { align-self: start; padding: 1rem; background: var(--vt-paper-2); border-radius: 3px; }
  .process-input { margin: 0; text-align: center; color: var(--vt-ink); font-size: var(--vt-text-small); }
  .process-arrow { display: block; margin: .4rem 0; text-align: center; color: var(--vt-ink-3); }
  .agent-cycle { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; list-style: none; margin: 0; padding: 0; }
  .agent-cycle li { position: relative; min-width: 0; padding: .75rem; background: var(--vt-paper); border: 1px solid var(--vt-rule); border-radius: 3px; }
  .agent-cycle li + li::before { content: '→'; position: absolute; top: .65rem; left: -1.25rem; color: var(--vt-seal-ink); }
  .agent-cycle h4 { font-size: var(--vt-text-small); }
  .agent-cycle p { margin: .3rem 0 0; font-size: var(--vt-text-small); }
  .process-feedback { display: flex; align-items: center; gap: .4rem; margin: .6rem 0 1rem; color: var(--vt-seal-ink); font-size: var(--vt-text-small); }
  .process-feedback > span { font-size: 1rem; }
  .process-output { padding-top: .8rem; border-top: 1px solid var(--vt-rule); }
  .process-output > span { color: var(--vt-ink-3); font-size: var(--vt-text-small); letter-spacing: .025em; }
  .process-output p { display: flex; align-items: baseline; gap: .5rem; margin: .2rem 0 0; color: var(--vt-ink); font-size: var(--vt-text-small); }
  .process-output p > span { color: var(--vt-verified); }
  .results-pair { display: grid; grid-template-columns: 1.45fr 1fr; gap: 2.4rem; }
  .attention-formula { margin: 1.2rem 0; color: var(--vt-seal-ink); font-size: 1.5rem; letter-spacing: -.035em; }
  .attention-parts { display: flex; flex-wrap: wrap; gap: .45rem 1.1rem; list-style: none; padding: 0; margin: 0 0 1rem; font-size: var(--vt-text-small); color: var(--vt-ink-2); }
  .attention-parts span { color: var(--vt-verified); margin-right: .4rem; }
  .attention > a { display: inline-block; margin-top: .5rem; }
  .corpus { border-left: 1px solid var(--vt-rule); padding-left: 1.6rem; }
  .corpus h3 { font-size: var(--vt-text-small); }
  .corpus-count { display: flex; align-items: baseline; gap: .7rem; margin: .7rem 0 0; }
  .corpus-count strong { color: var(--vt-ink); font-weight: 500; font-size: 2.8rem; line-height: 1.1; letter-spacing: -.07em; }
  .corpus-count > span { font-size: var(--vt-text-small); color: var(--vt-ink-3); }
  .count-label { margin: .4rem 0 .9rem; font-size: var(--vt-text-small); }
  .corpus-grid { display: grid; grid-template-columns: repeat(23, 1fr); gap: 3px; }
  .corpus-grid span { aspect-ratio: 1; background: var(--vt-paper-3); }
  .corpus-grid .paired { background: var(--vt-seal); opacity: .6; }
  .statement-count { font-size: var(--vt-text-small); margin-top: 1rem; }
  .statement-count strong { font-weight: 500; color: var(--vt-ink); }
  .corpus > p:not(.corpus-count, .scope-note, .statement-count) { font-size: var(--vt-text-body); }
  .corpus > a { display: block; margin-top: .55rem; font-size: var(--vt-text-small); }
  .all-examples { display: inline-block; margin-top: 1rem; }
  @media (max-width: 48rem) {
    .story-section { padding-block: 2rem; }
    .language-section { padding-top: 0; }
    .results-pair { grid-template-columns: 1fr; }
    .source-caption { flex-direction: column; gap: 0; }
    .corpus { border-left: 0; border-top: 1px solid var(--vt-rule); padding: 1.4rem 0 0; }
    .try-example > summary > span:last-child { display: block; margin: .4rem 0 0 1rem; }
    .results-pair { gap: 1.8rem; }
    .corpus-grid { max-width: 22rem; }
    .attention-formula { font-size: 1.25rem; }
  }
  @media (min-width: 40rem) and (max-width: 48rem) {
    .language-pair { gap: .9rem; }
    .proof-pair, .agent-pair { column-gap: .9rem; }
    .language-pair :global(pre) { padding: 1rem .75rem; }
    .language-code-heading { padding-inline: .75rem; }
    .proof-card, .agent-panel { padding: 1rem .75rem; }
    .proof-process { padding: .75rem; }
    .agent-cycle li { padding: .55rem; }
    .proof-relation { padding: .75rem; }
    .proof-visual { padding: .75rem; }
    .formula { font-size: 1rem; }
  }
  @media (max-width: 40rem) {
    .language-pair, .proof-pair, .agent-pair { grid-template-columns: 1fr; }
    .proof-pair, .agent-pair { row-gap: 1.25rem; }
    .proof-card, .agent-panel { display: flex; flex-direction: column; grid-row: auto; }
    .proof-process { align-self: stretch; }
    .proof-criteria { display: block; grid-row: auto; }
    .proof-source { align-self: start; }
  }
  @media (max-width: 25rem) {
    .formula { font-size: 1rem; }
  }
</style>
